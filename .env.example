ZALO_OA_ALLOWED_IDS=
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_WEBHOOK_SECRET=
ZALO_OPENAPI_BASE_URL=https://openapi.zalo.me
ZALO_WEBHOOK_REPLAY_DB=outputs/zalo_webhook_replay.sqlite3
ZALO_WEBHOOK_MAX_AGE_SECONDS=300

