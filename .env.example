# Port for the FastAPI server (Railway overrides this with PORT automatically)
API_PORT=8000

# SmartPlan Assistant gateway client (server-side only; never expose the secret in browser code)
SMARTPLAN_ASSISTANT_URL=
SMARTPLAN_ASSISTANT_SECRET=
SMARTPLAN_ASSISTANT_TIMEOUT_SECONDS=20
SMARTPLAN_ASSISTANT_POLL_INTERVAL_SECONDS=2

# Zalo Official Account adapter (server-side only; never expose tokens/secrets in browser code)
